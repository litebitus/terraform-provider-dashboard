{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "mock-every-kind"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "prometheus",
            "version": "v0",
            "spec": {
              "expr": "mock_deploys_total{env=~\"${env}\"}",
              "refId": "Anno"
            }
          },
          "enable": true,
          "hide": false,
          "iconColor": "blue",
          "name": "Mock deploys"
        }
      }
    ],
    "cursorSync": "Off",
    "description": "Every panel kind Grafana draws.",
    "editable": false,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Requests",
          "links": [
            {
              "title": "Mock job",
              "url": "https://mock.example/jobs/${job}",
              "targetBlank": true
            }
          ],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (job) (rate(mock_requests_total{env=~\"${env}\",job=~\"${job}\"}[5m]))",
                        "format": "time_series",
                        "instant": false,
                        "interval": "30s",
                        "legendFormat": "{{job}}",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.3.0",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "right",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "none"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "axisLabel": "requests",
                    "fillOpacity": 0,
                    "scaleDistribution": {
                      "log": 10,
                      "type": "log"
                    },
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    }
                  },
                  "decimals": 1,
                  "mappings": [],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "text",
                        "value": null
                      }
                    ]
                  },
                  "unit": "suffix:/s"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Up history",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
