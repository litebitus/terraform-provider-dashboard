                        "format": "time_series",
                        "instant": false,
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "status-history",
            "version": "13.3.0",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "showValue": "auto"
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {},
                  "mappings": [],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "text",
                        "value": null
                      }
                    ]
                  },
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Players",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (country) (mock_players{env=~\"${env}\"})",
                        "format": "table",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "geomap",
            "version": "13.3.0",
            "spec": {
              "options": {
                "basemap": {
                  "name": "Basemap",
                  "type": "default"
                },
                "controls": {
                  "mouseWheelZoom": true,
                  "showZoom": true
                },
                "layers": [
                  {
                    "location": {
                      "gazetteer": "public/gazetteer/countries.json",
                      "lookup": "country",
                      "mode": "lookup"
                    },
                    "name": "Players",
                    "type": "markers"
                  }
                ],
                "view": {
                  "id": "zero",
                  "lat": 0,
                  "lon": 0,
                  "zoom": 1
                }
              },
              "fieldConfig": {
                "defaults": {
                  "custom": {},
                  "mappings": [],
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "text",
                        "value": null
                      }
                    ]
                  },
                  "unit": "short"
                },
                "overrides": []
              }
            }
          }
        }
      },
